{
  "name": "无法校准少女",
  "version": "0.2.7",
  "autoSave": true,
  "quickSave": true,
  "preload": {
    "boot": "title",
    "runtime": [
      "page",
      "predict"
    ],
    "timeout": 12000,
    "onTimeout": "hint",
    "slowSpeedKBps": 250,
    "lookahead": {
      "windowSeconds": 30,
      "horizonSeconds": 180,
      "maxInstructions": 600,
      "defaultLineSeconds": 3,
      "autoLineSeconds": 2.6,
      "skipLineSeconds": 0.18
    },
    "chapter": {
      "scope": "current",
      "preload": "adaptive"
    },
    "stage": {
      "preludeSeconds": 60,
      "preludeImagesOnly": true,
      "preludeBudgetSeconds": 8
    },
    "fastForward": {
      "skipVoice": true
    },
    "fallback": {
      "default": "degrade",
      "image": "block",
      "audio": "degrade",
      "allowSkipWait": true,
      "maskDelayMs": 150
    }
  },
  "changeLog": "- 0.2.7 引擎更新到v0.5.0，加入了按键映射功能"
}